# Copier en .env pour surcharger les valeurs par défaut (toutes optionnelles en développement).
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://careneo:careneo@localhost:5432/careneo
# Obligatoire en production : chaîne aléatoire d'au moins 32 caractères.
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum
# true derrière HTTPS (cookie de session « Secure »)
COOKIE_SECURE=false
